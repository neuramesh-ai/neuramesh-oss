# NeuraMesh environment — copy to .env (never committed).
# Nothing below is required yet: week-1 foundations run entirely locally
# (MemoryStore + Docker postgres). Each block lists WHEN it activates.

# ── W2: cloud data plane (chat sync goes live) ─────────────────────────────
# Supabase project: Postgres + Auth + Storage. From app.supabase.com → settings/api.
SUPABASE_URL=
SUPABASE_ANON_KEY=                # new-style sb_publishable_… key
SUPABASE_SERVICE_ROLE_KEY=        # new-style sb_secret_… key
SUPABASE_DB_PASSWORD=             # the one DB credential you set by hand
SUPABASE_DB_URL=postgresql://postgres:${SUPABASE_DB_PASSWORD}@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_POOLER_URL=postgresql://postgres.<project-ref>:${SUPABASE_DB_PASSWORD}@aws-1-<region>.pooler.supabase.com:5432/postgres

# PowerSync instance (cloud or self-host) wired to the Supabase Postgres.
POWERSYNC_URL=
POWERSYNC_DEV_TOKEN=

# ── Auth: Clerk (NM_AUTH=clerk) ────────────────────────────────────────────
# One Clerk instance backs both surfaces. The desktop app mounts Clerk's widget;
# the web marketing site (apps/web) hands account creation to the SAME instance's
# hosted sign-up (URL derived from the publishable key) → /download. Use the SAME
# key for both (the VITE_ one is exposed to the browser, as Clerk intends).
CLERK_PUBLISHABLE_KEY=             # pk_test_… / pk_live_… (desktop app)
CLERK_SECRET_KEY=                  # sk_… (server; re-mints PowerSync tokens)
VITE_CLERK_PUBLISHABLE_KEY=        # = CLERK_PUBLISHABLE_KEY (apps/web build-time)

# ── W3: agents come alive (AgentHost / Claude Agent SDK) ───────────────────
# BYOK: stays on the machine, never sent to NeuraMesh cloud.
ANTHROPIC_API_KEY=

# ── W6: telemetry + signed builds ──────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
VITE_PH_KEY=                       # = POSTHOG_KEY (apps/web build-time page beacon; absent → no-op, prod build warns)
# macOS notarization (CI): APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, APPLE_TEAM_ID
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── control-api ────────────────────────────────────────────────────────────
PORT=8787

# /v1 auth: allow the legacy bare `x-nm-actor` header as a WHOLE credential (no token).
# Dev stacks need it — they have no Clerk to mint a bearer. PRODUCTION MUST SET THIS TO 0.
#
# The gate in app.ts is opt-OUT (`!== '0'`), so an environment that never sets it accepts an
# unauthenticated identity claim: anyone who knows a user's uuid can act as them. That is how it
# shipped open on prod (found and closed 2026-08-30). Until the default is inverted, EVERY new
# environment has to remember this line.
NM_ALLOW_ACTOR_HEADER=1
