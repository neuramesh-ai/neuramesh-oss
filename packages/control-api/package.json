{
  "name": "@neuramesh/control-api",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NM_ALLOW_ACTOR_HEADER=1 vitest run",
    "dev": "tsx watch src/server.ts",
    "gen:skill-seed": "tsx scripts/gen-skill-seed.ts",
    "gen:marketing-os-seed": "tsx scripts/gen-marketing-os-seed.ts",
    "migrate": "node scripts/migrate.mjs",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:hono --external:@hono/node-server --external:postgres --external:posthog-node --external:stripe --external:zod --external:fastembed",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --format=esm --outfile=index.js --external:hono --external:@hono/node-server --external:postgres --external:posthog-node --external:stripe --external:zod --external:fastembed"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@neuramesh/shared": "workspace:*",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "posthog-node": "^5.38.4",
    "stripe": "^18.5.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "fastembed": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
