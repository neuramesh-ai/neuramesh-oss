{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run web:build",
  "outputDirectory": "out/web",
  "framework": null,
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://api.neuramesh.app/v1/:path*" },
    { "source": "/auth/:path*", "destination": "https://api.neuramesh.app/auth/:path*" },
    { "source": "/connect/:path*", "destination": "https://api.neuramesh.app/connect/:path*" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
