    "query": {
      "theme": "cream-oak",
      "plan": "cloud",
      "openConvo": "marketing::browser terminal"
    },
    "settle": 3200,
    "js": "document.querySelector('.relcard')?.scrollIntoView({ block: 'center' })"
  },
  {
