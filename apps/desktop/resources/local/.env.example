# The desktop writes this file with mode0600. For manual setup copy it to .env.
# See docs/local-mode.md. Local sync uses the control API; no PowerSync service is required.

# The app version, also the control API image tag.
NM_IMAGE_TAG=0.153.0

# Absolute stack folder. Keep pgdata and brain-objects inside it across updates.
NM_LOCAL_DIR=/Users/<you>/.neuramesh/local

# sha256 of your nmh_ bearer. Keep the bearer in a password manager, only its hash here.
# Generate a bearer with: openssl rand -hex 24 (prefix the result with nmh_).
NM_LOCAL_HUMAN_TOKEN_HASH=

# Binds to 127.0.0.1 only.
NM_API_PORT=8788

# Optional GCS. Set BOTH fields and include docker-compose.gcs.yaml for manual setup.
# NM_BRAIN_GCS_BUCKET=your-private-bucket
# NM_BRAIN_ADC_FILE=/absolute/path/to/application_default_credentials.json

# Optional image name without its tag.
# NM_IMAGE=ghcr.io/neuramesh-ai/neuramesh-control-api
