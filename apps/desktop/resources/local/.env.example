# The env file for the NeuraMesh local stack (docker-compose.yaml in this folder).
# The desktop app writes this file for you, mode 0600. To run the stack yourself, copy this file
# to .env and fill every value. See docs/local-mode.md.

# The app version. It is also the control API image tag.
NM_IMAGE_TAG=0.133.0

# The absolute path of the folder that holds this stack. Postgres data lives in pgdata under it.
NM_LOCAL_DIR=/Users/<you>/.neuramesh/local

# 32 random bytes, base64url. The control API and PowerSync share it.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
NM_SYNC_KEY=

# A random string for PowerSync's admin API.
#   openssl rand -hex 24
NM_ADMIN_TOKEN=

# The sha256 hex of your bearer. The bearer is `nmh_` and 48 hex characters. Keep the bearer in
# your password manager. Only its hash goes here.
#   TOKEN="nmh_$(openssl rand -hex 24)"; echo "$TOKEN"; printf %s "$TOKEN" | shasum -a 256 | cut -d ' ' -f 1
NM_LOCAL_HUMAN_TOKEN_HASH=

# Host ports. Both bind to 127.0.0.1 only.
NM_API_PORT=8788
NM_POWERSYNC_PORT=58081

# Optional. The image name without its tag. The default is the published image.
# NM_IMAGE=ghcr.io/neuramesh-ai/neuramesh-control-api
