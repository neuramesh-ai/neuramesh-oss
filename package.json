{
  "name": "neuramesh",
  "private": true,
  "license": "Elastic-2.0",
  "version": "0.156.1",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:validate": "bash scripts/validate-db.sh",
    "test:pg": "bash scripts/test-pg.sh",
    "cloud:e2e": "node packages/control-api/scripts/cloud-e2e.mjs",
    "claim:e2e": "node packages/control-api/scripts/claim-e2e.mjs",
    "e2e": "bash scripts/dev-e2e.sh",
    "app": "bash scripts/cloud-app.sh",
    "app:local": "bash scripts/dev-app.sh",
    "eval:coding": "node scripts/coding-evals/cli.mjs",
    "eval:coding:test": "node --test scripts/coding-evals/*.test.mjs",
    "db:dev-migrate": "bash scripts/dev-migrate.sh",
    "db:cloud-migrate": "bash scripts/cloud-migrate.sh",
    "prepare": "husky",
    "mail:preview": "pnpm --filter @neuramesh/shared mail:preview"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "ai-sdk-provider-claude-code>@anthropic-ai/claude-agent-sdk": "0.3.263"
    }
  }
}
