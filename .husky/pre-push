# A SECRET-SHAPED VALUE STOPS HERE, BEFORE IT REACHES GITHUB.
#
# CI's public-scan reads the history of EVERY branch (scripts/public-scan.sh has no range), so one
# flagged commit on one pushed branch fails that job on every pull request until the commit leaves
# the remote. On 2026-11-14 a made-up key in a test file did exactly that to a pull request that
# never touched the file. The same scanner and the same config run here, on the commits this push
# adds, in about a second.
#
# IT BLOCKS ONLY ON EVIDENCE. No gitleaks binary, or a scan that cannot run, prints one line and
# lets the push through, and CI stays the gate.
#
# EACH WORKTREE RUNS ITS OWN COPY. core.hooksPath is the relative `.husky/_`, and git runs a hook
# from the root of the worktree that pushes, so the shim and this file are that worktree's own.
# husky writes `.husky/_` at `pnpm install`. A worktree with no install has no `.husky/_`, git
# runs no hook at all, and nothing here can say so: CI is the only check for that push.
ZERO=0000000000000000000000000000000000000000

# git feeds a pre-push hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
carried=
while read -r _localref localsha _remoteref _remotesha; do
  [ "$localsha" = "$ZERO" ] && continue                      # a branch delete carries no commits
  carried="$carried $localsha"
done

scanner=$(command -v gitleaks 2>/dev/null) || scanner=
if [ -z "$scanner" ] && [ -x "$HOME/.local/share/mise/shims/gitleaks" ]; then scanner="$HOME/.local/share/mise/shims/gitleaks"; fi
config=
[ -f .gitleaks.toml ] && config="--config .gitleaks.toml"
for sha in $carried; do
  if [ -z "$scanner" ]; then
    echo "pre-push: gitleaks is not installed, so this push was not scanned for secrets (brew install gitleaks). CI still scans it."
    break
  fi
  # the commits that no remote branch holds yet are what this push adds. 42 means a finding:
  # gitleaks exits 1 for its own errors, and an error must not stop a push
  code=0
  found=$("$scanner" git . $config --no-banner --redact -v --exit-code 42 --log-opts="$sha --not --remotes" 2>&1) || code=$?
  [ "$code" -eq 0 ] && continue
  if [ "$code" -ne 42 ]; then
    echo "pre-push: the secret scan could not run (gitleaks exit $code), so this push was not scanned. CI still scans it."
    break
  fi
  echo "$found"
  echo
  echo "  This push holds a value that looks like a secret (gitleaks, above)."
  echo
  echo "  CI scans the history of each branch. One such commit on GitHub fails the public scan"
  echo "  of each pull request, until the commit leaves the remote."
  echo
  echo "  Remove the value and change the commit, then push again:"
  echo
  echo "      git commit --amend           # the newest commit"
  echo "      git rebase -i origin/main    # an older commit"
  echo
  echo "  A made-up value in a test: build it when the test runs, or name the file in"
  echo "  .gitleaks.toml with the reason."
  echo
  exit 1
done
