# Block the commit unless the whole workspace typechecks and every test passes.
# Mirrors CI's gate. loop.pg.test.ts auto-skips without DATABASE_URL, so this stays
# fast and infra-free locally; CI runs it against a Postgres service.
# Git exports repository-local variables to hooks. Fixture repositories must use their own
# cwd, never this commit's index or Git directory. Keep the cleanup inside the hook process.
unset $(git rev-parse --local-env-vars)
pnpm check
